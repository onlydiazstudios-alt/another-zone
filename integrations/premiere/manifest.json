{
  "id": "com.anotherzone.srtstudio.premiere",
  "name": "Another Zone SRT Studio",
  "version": "0.1.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.6.0"
    }
  ],
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "anotherzonesrtpanel",
      "minimumSize": {
        "width": 300,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 620
      },
      "preferredFloatingSize": {
        "width": 440,
        "height": 680
      },
      "label": {
        "default": "Another Zone SRT Studio"
      }
    }
  ]
}